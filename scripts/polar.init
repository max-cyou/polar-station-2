#!/bin/sh
# Polar service for BusyBox init on Yandex Station 2.

base=/data/opt/polar
binary=$base/polar
pidfile=$base/polar.pid
logfile=$base/polar.log

is_polar() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -gt 1 ] || return 1
  case "$(readlink "/proc/$1/exe" 2>/dev/null)" in
    "$executable"|"$executable (deleted)") return 0 ;;
  esac
  return 1
}

find_pids() {
  for entry in /proc/[0-9]*/exe; do
    pid=${entry#/proc/}
    pid=${pid%/exe}
    if is_polar "$pid"; then
      echo "$pid"
    fi
  done
}

start() {
  [ -x "$binary" ] || { echo "Polar binary not found: $binary" >&2; return 1; }
  pids=$(find_pids)
  if [ -n "$pids" ]; then
    case "$pids" in
      *'
'*) echo "Multiple Polar processes found; refusing to start another" >&2; return 1 ;;
    esac
    echo "$pids" > "$pidfile"
    echo "Polar is already running (PID $pids)"
    return 0
  fi
  cd "$base" || return 1
  nohup "$binary" -listen :8080 </dev/null >"$logfile" 2>&1 &
  pid=$!
  echo "$pid" > "$pidfile"
  sleep 1
  if ! is_polar "$pid"; then
    rm -f "$pidfile"
    echo "Polar failed to start; see $logfile" >&2
    return 1
  fi
  echo "Polar started on port 8080 (PID $pid)"
}

stop() {
  pids=$(find_pids)
  for pid in $pids; do
    if is_polar "$pid"; then
      kill "$pid" || return 1
    fi
  done
  tries=0
  while [ -n "$(find_pids)" ]; do
    tries=$((tries + 1))
    if [ "$tries" -ge 50 ]; then
      echo "Polar did not stop; refusing to force termination" >&2
      return 1
    fi
    sleep 0.1
  done
  rm -f "$pidfile"
  echo "Polar stopped"
}

executable=$(readlink -f "$binary") || exit 1
[ -n "$executable" ] || exit 1

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop && start ;;
  status)
    pids=$(find_pids)
    if [ -n "$pids" ]; then
      echo "Polar is running (PID $pids)"
    else
      echo "Polar is stopped"
      exit 1
    fi
    ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
